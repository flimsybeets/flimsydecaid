{
  "name": "flimsydecaid",
  "private": true,
  "version": "0.2.11",
  "type": "module",
  "description": "A category-first Decaid skin for the Decent DE1",
  "license": "AGPL-3.0-or-later",
  "scripts": {
    "dev": "vite --host",
    "build": "vite build",
    "preview": "vite preview --host",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "package": "npm run build && node scripts/package.mjs",
    "install:tablet": "node scripts/install-to-tablet.mjs",
    "art:guide": "node scripts/guide-art/build.cjs"
  },
  "devDependencies": {
    "@fontsource-variable/sen": "^5.3.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tsconfig/svelte": "^5.0.8",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.7",
    "typescript": "~5.9.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
